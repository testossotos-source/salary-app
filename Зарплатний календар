<!DOCTYPE html>
<html lang="uk">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Зарплатний Календар</title>
  <style>
    :root { --bg:#f2f2f7; --card:#fff; --blue:#007aff; --green:#34c759; --red:#ff3b30; --text:#1c1c1e; --sub:#6c6c70; --border:rgba(60,60,67,0.12); }
    * { box-sizing:border-box; margin:0; padding:0; -webkit-tap-highlight-color:transparent; font-family:-apple-system,sans-serif; }
    body { background:var(--bg); color:var(--text); padding:52px 10px 70px; min-height:100vh; }
    .header { position:fixed; top:0; left:0; right:0; height:48px; background:rgba(249,249,249,0.95); backdrop-filter:blur(10px); border-bottom:1px solid var(--border); display:flex; align-items:center; justify-content:center; font-weight:600; font-size:16px; z-index:10; }
    .tab { display:none; max-width:480px; margin:0 auto; }
    .tab.active { display:block; }
    .title { font-size:11px; font-weight:600; color:var(--sub); text-transform:uppercase; margin:12px 4px 6px; }
    .card { background:var(--card); border-radius:12px; padding:12px; margin-bottom:12px; border:1px solid var(--border); }
    .group { margin-bottom:10px; }
    .group label { font-size:12px; color:var(--sub); display:block; margin-bottom:3px; }
    input, select { width:100%; padding:10px; background:#f8f8fa; border:1px solid #e5e5ea; border-radius:8px; font-size:15px; outline:none; }
    .btn { width:100%; padding:12px; border-radius:10px; border:none; font-size:15px; font-weight:600; cursor:pointer; color:#fff; }
    .btn-blue { background:var(--blue); }
    .btn-green { background:var(--green); }
    .btn-del { background:rgba(255,59,48,0.12); color:var(--red); padding:5px 10px; font-size:12px; border-radius:6px; border:none; cursor:pointer; font-weight:600; }
    .item { display:flex; justify-content:space-between; align-items:center; background:var(--card); padding:12px; border-radius:12px; border:1px solid var(--border); margin-bottom:8px; }
    .grid { display:grid; grid-template-columns:repeat(7,1fr); gap:4px; text-align:center; }
    .cell { background:#f8f8fa; border-radius:8px; aspect-ratio:1; display:flex; flex-direction:column; align-items:center; justify-content:center; font-size:12px; border:1px solid var(--border); cursor:pointer; }
    .cell.work { background:#eafaf1; border-color:var(--green); color:#1a7f37; }
    .cell.half { background:#fff8eb; border-color:#ff9500; color:#b26a00; }
    .nav { position:fixed; bottom:0; left:0; right:0; height:60px; background:rgba(249,249,249,0.95); backdrop-filter:blur(10px); border-top:1px solid var(--border); display:flex; justify-content:space-around; align-items:center; }
    .nav-btn { background:none; border:none; color:var(--sub); font-size:10px; display:flex; flex-direction:column; align-items:center; flex:1; cursor:pointer; }
    .nav-btn.active { color:var(--blue); font-weight:600; }
    .nav-btn span { font-size:18px; margin-bottom:2px; }
    .badge { padding:3px 8px; border-radius:10px; font-size:11px; font-weight:600; }
    .badge-red { background:rgba(255,59,48,0.12); color:var(--red); }
    .badge-green { background:rgba(52,199,89,0.12); color:var(--green); }
  </style>
</head>
<body>

  <div class="header">Зарплатний Календар</div>

  <!-- Вкладка 1: Робітники -->
  <div id="t1" class="tab active">
    <div class="title">Додати робітника</div>
    <div class="card">
      <div class="group"><label>ПІБ / Ім'я</label><input type="text" id="wn" placeholder="Олег"></div>
      <div class="group"><label>Ставка за день (грн)</label><input type="number" id="wr" placeholder="400"></div>
      <button class="btn btn-blue" onclick="addW()">+ Додати робітника</button>
    </div>
    <div class="title">Список робітників</div>
    <div id="w-list"></div>
  </div>

  <!-- Вкладка 2: Табель -->
  <div id="t2" class="tab">
    <div class="title">Параметри</div>
    <div class="card">
      <div class="group"><label>Робітник</label><select id="cs" onchange="renderCal()"></select></div>
      <div class="group"><label>Місяць</label><input type="month" id="cm" onchange="renderCal()"></div>
    </div>
    <div id="c-info" class="card" style="text-align:center; font-size:13px; font-weight:600;"></div>
    <div class="card">
      <div class="grid" style="font-weight:600; color:var(--sub); font-size:11px; margin-bottom:6px;">
        <span>Пн</span><span>Вт</span><span>Ср</span><span>Чт</span><span>Пт</span><span>Сб</span><span>Нд</span>
      </div>
      <div id="c-grid" class="grid"></div>
    </div>
  </div>

  <!-- Вкладка 3: Виплати -->
  <div id="t3" class="tab">
    <div class="title">Нова виплата</div>
    <div class="card">
      <div class="group"><label>Робітник</label><select id="ps"></select></div>
      <div class="group"><label>Сума (грн)</label><input type="number" id="pa" placeholder="1000"></div>
      <div class="group"><label>Дата</label><input type="date" id="pd"></div>
      <div class="group"><label>Коментар</label><input type="text" id="pc" placeholder="Аванс"></div>
      <button class="btn btn-green" onclick="addP()">💳 Зафіксувати виплату</button>
    </div>
    <div class="title">Історія виплат</div>
    <div id="p-list"></div>
  </div>

  <!-- Вкладка 4: Підсумок -->
  <div id="t4" class="tab">
    <div class="title">Загальний баланс</div>
    <div id="s-list"></div>
  </div>

  <!-- Нижнє меню -->
  <div class="nav">
    <button class="nav-btn active" onclick="showTab('t1', this)"><span>👤</span>Робітники</button>
    <button class="nav-btn" onclick="showTab('t2', this)"><span>📅</span>Табель</button>
    <button class="nav-btn" onclick="showTab('t3', this)"><span>💳</span>Виплати</button>
    <button class="nav-btn" onclick="showTab('t4', this)"><span>📊</span>Підсумок</button>
  </div>

  <script>
    let W = JSON.parse(localStorage.getItem('W')||'[]');
    let D = JSON.parse(localStorage.getItem('D')||'{}');
    let P = JSON.parse(localStorage.getItem('P')||'[]');

    function save(){
      try{
        localStorage.setItem('W',JSON.stringify(W));
        localStorage.setItem('D',JSON.stringify(D));
        localStorage.setItem('P',JSON.stringify(P));
      }catch(e){}
    }

    function showTab(id, btn){
      document.querySelectorAll('.tab').forEach(t=>t.classList.remove('active'));
      document.querySelectorAll('.nav-btn').forEach(b=>b.classList.remove('active'));
      document.getElementById(id).classList.add('active');
      btn.classList.add('active');
      renderAll();
    }

    function addW(){
      let n = document.getElementById('wn').value.trim();
      let r = parseFloat(document.getElementById('wr').value);
      if(!n || isNaN(r)) return alert('Введіть ім\'я та ставку!');
      W.push({id:''+Date.now(), name:n, rate:r});
      save();
      document.getElementById('wn').value='';
      document.getElementById('wr').value='';
      renderAll();
      alert('Робітника додано!');
    }

    function delW(id){
      if(confirm('Видалити робітника?')){ W = W.filter(w=>w.id!==id); save(); renderAll(); }
    }

    function addP(){
      let id = document.getElementById('ps').value;
      let a = parseFloat(document.getElementById('pa').value);
      let d = document.getElementById('pd').value;
      let c = document.getElementById('pc').value.trim();
      if(!id || isNaN(a) || !d) return alert('Заповніть всі поля!');
      P.push({id:''+Date.now(), wId:id, amt:a, date:d, note:c});
      save();
      document.getElementById('pa').value='';
      document.getElementById('pc').value='';
      renderAll();
      alert('Виплату додано!');
    }

    function delP(id){
      if(confirm('Видалити виплату?')){ P = P.filter(p=>p.id!==id); save(); renderAll(); }
    }

    function renderAll(){
      // 1. Робітники
      let wl = document.getElementById('w-list');
      wl.innerHTML = W.length ? '' : '<div class="card" style="text-align:center;color:#6c6c70;">Робітників немає</div>';
      let opts = W.length ? '' : '<option value="">-- Додайте робітника --</option>';
      W.forEach(w=>{
        wl.innerHTML += `<div class="item"><div><b>${w.name}</b><br><small style="color:#6c6c70">${w.rate} грн/день</small></div><button class="btn-del" onclick="delW('${w.id}')">Видалити</button></div>`;
        opts += `<option value="${w.id}">${w.name}</option>`;
      });
      document.getElementById('cs').innerHTML = opts;
      document.getElementById('ps').innerHTML = opts;

      // 2. Календар
      renderCal();

      // 3. Виплати
      let pl = document.getElementById('p-list');
      pl.innerHTML = P.length ? '' : '<div class="card" style="text-align:center;color:#6c6c70;">Виплат немає</div>';
      [...P].reverse().forEach(p=>{
        let w = W.find(x=>x.id===p.wId);
        pl.innerHTML += `<div class="item"><div><b>${w?w.name:'—'}: <span style="color:#34c759">+${p.amt} грн</span></b><br><small style="color:#6c6c70">${p.date} ${p.note?'• '+p.note:''}</small></div><button class="btn-del" onclick="delP('${p.id}')">✕</button></div>`;
      });

      // 4. Підсумок
      let sl = document.getElementById('s-list');
      sl.innerHTML = W.length ? '' : '<div class="card" style="text-align:center;color:#6c6c70;">Додайте робітників</div>';
      W.forEach(w=>{
        let days = 0;
        Object.keys(D).forEach(k=>{ if(k.startsWith(w.id+'_')) days += D[k]; });
        let earned = days * w.rate;
        let paid = P.filter(p=>p.wId===w.id).reduce((s,p)=>s+p.amt, 0);
        let bal = earned - paid;
        sl.innerHTML += `<div class="card">
          <div style="display:flex;justify-content:space-between;margin-bottom:8px;">
            <b>${w.name}</b>
            <span class="badge ${bal>0?'badge-red':'badge-green'}">${bal>0?'Борг':(bal===0?'Розраховано':'Переплата')}</span>
          </div>
          <div style="font-size:13px;line-height:1.6;color:#6c6c70">
            <div style="display:flex;justify-content:space-between"><span>Відпрацьовано:</span><b>${days.toFixed(1)} дн.</b></div>
            <div style="display:flex;justify-content:space-between"><span>Нараховано:</span><b>${earned.toLocaleString()} грн</b></div>
            <div style="display:flex;justify-content:space-between"><span>Виплачено:</span><b style="color:#34c759">${paid.toLocaleString()} грн</b></div>
            <div style="display:flex;justify-content:space-between;margin-top:6px;padding-top:6px;border-top:1px solid #e5e5ea;font-size:15px;font-weight:700;color:${bal>0?'#ff3b30':'#34c759'}">
              <span>${bal>=0?'До сплати:':'Переплата:'}</span><span>${Math.abs(bal).toLocaleString()} грн</span>
            </div>
          </div>
        </div>`;
      });
    }

    function renderCal(){
      let wId = document.getElementById('cs').value;
      let mStr = document.getElementById('cm').value;
      let grid = document.getElementById('c-grid');
      grid.innerHTML = '';
      if(!wId || !mStr) return document.getElementById('c-info').innerHTML = 'Оберіть робітника та місяць';

      let worker = W.find(x=>x.id===wId);
      let [y, m] = mStr.split('-').map(Number);
      let firstDay = (new Date(y, m - 1, 1).getDay() + 6) % 7;
      let daysInM = new Date(y, m, 0).getDate();
      let totDays = 0;

      for(let i=0; i<firstDay; i++) grid.innerHTML += '<div></div>';

      for(let d=1; d<=daysInM; d++){
        let key = `${wId}_${mStr}-${String(d).padStart(2,'0')}`;
        let st = D[key] || 0;
        totDays += st;
        let cls = st===1?'work':(st===0.5?'half':'');
        let lbl = st===1?'1.0':(st===0.5?'0.5':'—');

        let cell = document.createElement('div');
        cell.className = `cell ${cls}`;
        cell.innerHTML = `<b>${d}</b><span style="font-size:8px">${lbl}</span>`;
        cell.onclick = ()=>{
          let nxt = st===0 ? 1 : (st===1 ? 0.5 : 0);
          if(nxt===0) delete D[key]; else D[key]=nxt;
          save(); renderCal(); renderAll();
        };
        grid.appendChild(cell);
      }

      document.getElementById('c-info').innerHTML = `Відпрацьовано: <b>${totDays.toFixed(1)} дн.</b> | Нараховано: <b style="color:#007aff">${(totDays*(worker?worker.rate:0)).toLocaleString()} грн</b>`;
    }

    let now = new Date();
    document.getElementById('pd').valueAsDate = now;
    document.getElementById('cm').value = now.toISOString().slice(0,7);
    renderAll();
  </script>
</body>
</html>
